SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Service-role key — required for admin panel + CMS server functions. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ARK Finance Consultancy <your-email@gmail.com>

# Admin bootstrap (used once by /admin/setup to create the first admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_SETUP_TOKEN=long-random-token-here
